---
layout: "base.njk"
---

{% block styles %}
<link rel="stylesheet" href="{{ pathPrefix }}/css/note-preview.css">
{% endblock %}

{% block content %}
<div class="content-wrapper">
    <div class="article">
        <article class="article__content note-preview">
            {{ content | safe }}
        </article>
    </div>
</div>

{% if upd_date %}
<div class="page-updated">
    <small>{{ upd_date | readableDate }}</small>
</div>
{% endif %}
{% endblock %}
