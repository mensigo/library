{#- Знаки групп заметок. Один рисунок на группу, два вида:
      sigil(id, "wall") - на стене в комнате: штрихи с pathLength и --w/--d (длительность
                          и задержка штриха), рисуются, когда курсор на группе (room.css);
      sigil(id, "mark") - уже дорисованный знак на странице группы и в крошках заметки.
    Новой группе нужен свой рисунок здесь и свой --done в note-groups.css: когда
    кончается последний штрих (его --w + --d). Подключение:
      {% from "world/note-sigils.njk" import sigil %} -#}
{%- macro sigil(id, mode) -%}
{%- set strokes = {
  python: [
    { k: 'brush', d: 'M60 322 C150 362 252 332 236 270 C222 218 108 236 120 174 C131 114 292 150 290 94 C289 60 250 44 214 60' },
    { k: 'thin', w: '1.25s', dl: '.35s', d: 'M202 64 L180 71 L167 62 M180 71 L170 82' },
    { k: 'dot', cx: 228, cy: 57, r: 3.2 }
  ],
  docker: [
    { k: 'line', dl: '1.3s', d: 'M60 222 C60 152 150 132 230 152 C280 164 310 172 330 152 C322 132 335 112 355 106 C350 131 372 141 381 129 C378 166 350 186 330 192 C300 262 200 292 130 277 C90 268 60 252 60 222 Z' },
    { k: 'thin', w: '1.1s', dl: '.4s', d: 'M76 238 C120 264 200 264 258 238' },
    { k: 'thin', w: '1.4s', dl: '.5s', d: 'M150 132 C150 108 140 94 124 87 M150 132 C152 106 165 94 181 89' },
    { k: 'thin', w: '1.7s', dl: '.6s', d: 'M196 138 h22 v-20 h-22 Z M222 142 h22 v-20 h-22 Z M209 116 h22 v-20 h-22 Z' },
    { k: 'dot', cx: 104, cy: 208, r: 4 }
  ]
}[id] -%}
{%- set wall = mode == 'wall' -%}
{%- set cls = 'sigil' if wall else 'mark' -%}
<svg class="{{ cls }}"{% if wall %} data-g="{{ id }}"{% endif %} viewBox="0 0 400 400" fill="none" stroke-linecap="round" stroke-linejoin="round"{% if not wall %} aria-hidden="true"{% endif %}>
{%- for s in strokes %}
  {% if s.k == 'dot' -%}
  <circle class="{{ cls }}__dot" cx="{{ s.cx }}" cy="{{ s.cy }}" r="{{ s.r }}"/>
  {%- else -%}
  {%- set style = '--w:' + s.w if s.w else '' -%}
  {%- if s.dl %}{% set style = style + (';' if style else '') + '--d:' + s.dl %}{% endif -%}
  <path class="{{ cls }}__{{ s.k }}"{% if wall %} pathLength="1"{% if style %} style="{{ style }}"{% endif %}{% endif %} d="{{ s.d }}"/>
  {%- endif -%}
{%- endfor %}
</svg>
{%- endmacro -%}
