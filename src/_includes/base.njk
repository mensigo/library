<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>

    {% block meta %}
    <meta name="title" content="{{ title }}">
    <meta property="og:site_name" content="my-site.com">
    <meta property="og:description" content="{{ tg_desc | default('Some description..') }}">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ title }}">
    <meta property="article:author" content="lonalone">
    <meta property="article:published_time" content="{{ tg_pub_time | default('2025-11-01T00:00:00+03:00') | dateToRfc3339 }}">
    <meta property="telegram:channel" content="@lonalone1">
    <meta property="tg:site_verification" content="g7j8/rPFXfhyrq5q0QQV7EsYWv4=">
    {% endblock %}

    <!-- Предзагрузка шрифтов -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ pathPrefix }}/css/styles.css">
    {% block styles %}{% endblock %}
    <script>
        // Применяем тему до загрузки страницы, чтобы избежать мигания
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body class="cyrillic-optimized">
    <!-- Верхняя навигационная панель -->
    <nav class="navbar">
        <div class="navbar__container">
            {% set isNotesPage = page.url | startsWith('/notes/') %}
            <div class="navbar__section {% if not isNotesPage %}navbar__section--active{% endif %}" data-section="library">
                <span>📚 Reviews</span>
            </div>
            <div class="navbar__section {% if isNotesPage %}navbar__section--active{% endif %}" data-section="notes">
                <span>📝 Notes</span>
            </div>
        </div>
    </nav>

    <!-- Кнопка гамбургер-меню -->
    <button class="menu-toggle" id="menuToggle" aria-label="Открыть меню">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <!-- Переключатель темы -->
    <button class="theme-toggle" id="themeToggle" aria-label="Переключить тему">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
    </button>

    <!-- Затемнение фона -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Трехколоночный макет -->
    <div class="three-column-layout">
        <!-- Левая навигация -->
        <nav class="sidebar-left" id="sidebarLeft">
            <!-- Заголовок сайта -->
            <div class="sidebar-header">
                <a href="{{ pathPrefix }}/" class="site-logo-link">
                    <img src="{{ pathPrefix }}/images/logo.png" alt="Logo" class="site-logo">
                </a>
                <a href="{{ pathPrefix }}/" class="site-title">Мысли и заметки</a>
                <div class="site-subtitle">Собрание размышлений</div>
            </div>

            <!-- Поиск -->
            <div class="search-container">
                <div class="search-box">
                    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input type="text" id="searchInput" placeholder="Поиск..." class="search-input" aria-label="Поиск по заголовкам страниц" role="searchbox" aria-expanded="false" aria-haspopup="listbox">
                    <span class="search-shortcut">Ctrl K</span>
                </div>
            </div>

            <!-- Навигационное дерево -->
            <div class="nav-tree">
                <!-- Главная страница -->
                <div class="nav-section nav-section--main">
                    <div class="tree-item">
                        <div class="tree-item-self {% if (not isNotesPage and page.url == '/') or (isNotesPage and page.url == '/notes/') %}mod-active{% endif %}">
                            <div class="tree-item-inner">
                                {% if isNotesPage %}
                                <a href="{{ pathPrefix }}/notes/">🏠︎ Главная (Заметки)</a>
                                {% else %}
                                <a href="{{ pathPrefix }}/">🏠︎ Главная</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Аниме -->
                <div class="nav-section nav-section--anime">
                {% set isAnimePage = page.url == '/reviews/anime/' or (page.url | startsWith('/reviews/anime/')) %}
                <div class="tree-item">
                    <div class="tree-item-self mod-collapsible {% if isAnimePage %}is-clickable{% endif %}" data-path="anime">
                        <div class="tree-item-icon collapse-icon {% if not isAnimePage %}is-collapsed{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon right-triangle">
                                <path d="M3 8L12 17L21 8"></path>
                            </svg>
                        </div>
                        <div class="tree-item-inner">
                            <span>⛩️ Аниме</span>
                        </div>
                    </div>
                    <div class="tree-item-children {% if not isAnimePage %}is-collapsed{% endif %}">
                        <div class="tree-item">
                            <div class="tree-item-self {% if page.url == '/reviews/anime/' %}mod-active{% endif %}">
                                <div class="tree-item-inner">
                                    <a href="{{ pathPrefix }}/reviews/anime/">⭐ Интро</a>
                                </div>
                            </div>
                        </div>
                        {% for anime in collections.anime %}
                        <div class="tree-item">
                            <div class="tree-item-self {% if page.url == anime.url %}mod-active{% endif %}">
                                <div class="tree-item-inner">
                                    <a href="{{ pathPrefix }}{{ anime.url }}">{{ anime.data.title }}</a>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                </div>

                <!-- Философия -->
                {% if collections.philosophyCategories and collections.philosophyCategories | length > 0 %}
                <div class="nav-section nav-section--philosophy">
                {% set isPhilosophyPage = page.url | startsWith('/reviews/philosophy/') %}
                <div class="tree-item">
                    <div class="tree-item-self mod-collapsible {% if isPhilosophyPage %}is-clickable{% endif %}" data-path="philosophy">
                        <div class="tree-item-icon collapse-icon {% if not isPhilosophyPage %}is-collapsed{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon right-triangle">
                                <path d="M3 8L12 17L21 8"></path>
                            </svg>
                        </div>
                        <div class="tree-item-inner">
                            <span>🏛️ Философия</span>
                        </div>
                    </div>
                    <div class="tree-item-children {% if not isPhilosophyPage %}is-collapsed{% endif %}">
                        {% for categoryName, category in collections.philosophyCategories %}
                        {% set categoryPath = '/reviews/philosophy/' + categoryName + '/' %}
                        {% set isCategoryPage = page.url | startsWith(categoryPath) %}
                        <div class="tree-item">
                            <div class="tree-item-self mod-collapsible {% if isCategoryPage %}is-clickable{% endif %}" data-path="philosophy-{{ categoryName }}">
                                <div class="tree-item-icon collapse-icon {% if not isCategoryPage %}is-collapsed{% endif %}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon right-triangle">
                                        <path d="M3 8L12 17L21 8"></path>
                                    </svg>
                                </div>
                                <div class="tree-item-inner">
                                    <span>{{ categoryName | capitalize }}</span>
                                </div>
                            </div>
                            <div class="tree-item-children {% if not isCategoryPage %}is-collapsed{% endif %}">
                                {% for item in category.items %}
                                <div class="tree-item">
                                    <div class="tree-item-self {% if page.url == item.url %}mod-active{% endif %}">
                                        <div class="tree-item-inner">
                                            <a href="{{ pathPrefix }}{{ item.url }}">{{ item.data.title }}</a>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                </div>
                {% endif %}

                <!-- Заметки -->
                <div class="nav-section nav-section--notes-section">
                {% set isNotesPage = page.url | startsWith('/notes/') %}
                {% set isPythonPage = page.url | startsWith('/notes/python/') %}
                <div class="tree-item">
                    <div class="tree-item-self mod-collapsible {% if isPythonPage %}is-clickable{% endif %}" data-path="notes-python">
                        <div class="tree-item-icon collapse-icon {% if not isPythonPage %}is-collapsed{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon right-triangle">
                                <path d="M3 8L12 17L21 8"></path>
                            </svg>
                        </div>
                        <div class="tree-item-inner">
                            <span>🐍 Python</span>
                        </div>
                    </div>
                    <div class="tree-item-children {% if not isPythonPage %}is-collapsed{% endif %}">
                        {% for note in collections.notes %}
                        {% if note.url | startsWith('/notes/python/') %}
                        <div class="tree-item">
                            <div class="tree-item-self {% if page.url == note.url %}mod-active{% endif %}">
                                <div class="tree-item-inner">
                                    <a href="{{ pathPrefix }}{{ note.url }}">{{ note.data.title }}</a>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
                </div>
        </nav>

        <!-- Центральный контент -->
        <main class="content-center">
            {% block content %}
                {{ content | safe }}
            {% endblock %}
            {% block footer %}{% endblock %}
        </main>

        <!-- Правое меню "На этой странице" -->
        <aside class="sidebar-right" id="sidebarRight">
            <div class="toc-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>На этой странице</span>
            </div>
            <nav class="toc-nav" id="tocNav">
                <!-- TOC будет заполнено через JavaScript -->
            </nav>
        </aside>
    </div>

    <script src="{{ pathPrefix }}/js/scripts.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>