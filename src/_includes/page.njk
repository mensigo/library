---
layout: "base.njk"
---

<header class="hero">
    {% if tags %}
    <div class="hero__tags">
        {% for tag in tags %}
        <span class="chip{% if loop.first %} chip--acc{% endif %}">{{ tag }}</span>
        {% endfor %}
    </div>
    {% endif %}

    <h1>{{ title }}</h1>

    {% if lede %}
    <p class="hero__lede">{{ lede }}</p>
    {% endif %}

    <div class="hero__meta">
        {% if score %}
        <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 4 2.5 5.1 5.5.8-4 3.9.9 5.6-4.9-2.6-4.9 2.6.9-5.6-4-3.9 5.5-.8Z"/></svg>
            <b>{{ score | getScoreValue }}</b>&#8202;/&#8202;10
        </span>
        {% endif %}
        {# Полные статусы аниме/манги живут в .railcard, чтобы не раздувать hero #}
        {% if upd_date %}
        <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
            <time datetime="{{ upd_date | dateToRfc3339 }}">{{ upd_date | readableDate }}</time>
        </span>
        {% endif %}
    </div>
</header>

<article class="prose">
    {{ content | safe }}
</article>

{% if upd_date %}
<div class="doc__foot">
    <span>Обновлено {{ upd_date | readableDate }}</span>
</div>
{% endif %}
