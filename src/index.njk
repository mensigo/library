---
# Комната: / (pitch index-g.html). Стена с группами заметок - тот же экран под #notes,
# камеру туда везет wall.js. Числа на карточках - из коллекций, кроме Cinema: у нее
# свои счетчики, как на ее странице. Из коллекций исключена, как страницы групп.
layout: world/shell.njk
bundle: home
expectReady: true
title: Библиотека
eleventyExcludeFromCollections: true
---
{%- from "world/note-sigils.njk" import sigil -%}
{%- set notesCount = collections.notes | length -%}
{%- set reviewsCount = collections.reviews | length -%}
<header class="hero" id="hero">
  <!-- Мир: комната и стена справа от нее. По клику на «Заметки» камера уезжает вправо,
       то есть весь мир сдвигается влево, пока стена не займет экран. -->
  <div class="world">
  <div class="wall" aria-hidden="true">
    <!-- Знаки групп рисуются на стене штрих за штрихом, когда курсор на группе -->
    {%- for g in noteGroups %}
    {{ sigil(g.id, "wall") }}
    {%- endfor %}
  </div>
  <div class="stage">
    <!-- Стоп-кадр без видео, 2274x1280: AVIF, где браузер его понимает, иначе JPG.
         Обе - сжатые копии апскейла room.png из library_static (images/world/meta.md) -->
    <picture>
      <source type="image/avif" srcset="{{ pathPrefix }}/images/world/room.avif">
      <img class="stage__img" src="{{ pathPrefix }}/images/world/room.jpg"
           alt="Парень в худи полулежит на диване в кальянной с трубкой в руке и смотрит вверх; за окном дождь и неоновая вывеска">
    </picture>
    <!-- «Дыхание» сцены: пульсация огней. --x/--y/--d заданы в долях кадра,
         по одному на каждый источник света в кадре. -->
    <div class="glows" aria-hidden="true">
      <i class="glow" style="--x:2.3%;--y:24.5%;--d:22%;--t:4.3s;--s:-1.2s"></i>
      <i class="glow" style="--x:5.1%;--y:81.5%;--d:30%;--t:5.1s;--s:-3.4s"></i>
      <i class="glow" style="--x:24.2%;--y:33%;--d:8%;--t:3.1s;--s:-0.6s"></i>
      <i class="glow" style="--x:28.8%;--y:46.8%;--d:4%;--t:2.9s;--s:-1.9s"></i>
      <i class="glow" style="--x:41.3%;--y:51%;--d:5%;--t:3.7s;--s:-2.1s"></i>
      <i class="glow glow--faint" style="--x:55.3%;--y:74.4%;--d:4.5%;--t:4.7s;--s:-2.8s"></i>
      <i class="glow" style="--x:64.5%;--y:56.4%;--d:5%;--t:3.4s;--s:-1.7s"></i>
      <i class="glow" style="--x:68.2%;--y:75.5%;--d:10%;--t:2.7s;--s:-0.3s"></i>
    </div>
    <canvas class="stage__smoke" id="smoke" data-exhale="off" data-coal="465,187" aria-hidden="true"></canvas>
  </div>
  </div>
  <div class="scrim"></div>

  <div class="hud">
    <span class="dot"></span>
    <b>БИБЛИОТЕКА</b>
    <span class="sep">/</span>
    <span id="crumb">главная</span>
  </div>

  <div class="panel">
    <div class="panel__head">
      <span class="kicker">Заметки и обзоры</span>
      <h1>Сгорает <span class="co">суета</span>,<br><span class="panel__l2">разогревая <span class="co">разум</span>.</span></h1>
    </div>

    <nav class="cards" aria-label="Разделы">
      <a class="card" href="#notes" data-pan data-title="Заметки">
        <span class="card__k">01 / заметки</span>
        <span class="card__t">Заметки</span>
        <span class="card__d">Python изнутри: от tuple до async.</span>
        <span class="card__m"><b>{{ notesCount }}</b> {{ notesCount | plural('заметка', 'заметки', 'заметок') }} <i>→</i></span>
      </a>
      <a class="card" href="#reviews" data-title="Обзоры" data-soon="Раздел еще пишется.">
        <span class="card__k">02 / обзоры</span>
        <span class="card__t">Обзоры</span>
        <span class="card__d">Аниме и философия. С оценкой и вердиктом.</span>
        <span class="card__m"><b>{{ reviewsCount }}</b> {{ reviewsCount | plural('обзор', 'обзора', 'обзоров') }} <i>→</i></span>
      </a>
      <a class="card" href="{{ pathPrefix }}/cinema/" data-title="Cinema" data-cine>
        <span class="card__k">03 / cinema</span>
        <span class="card__t">Cinema</span>
        <span class="card__d">Большие разборы с кадрами. Cowboy Bebop.</span>
        <span class="card__m"><b>1</b> разбор <i>→</i></span>
      </a>
    </nav>
  </div>

  <!-- Выбор группы у стены. Справа от списка на стене проявляется знак группы.
       Группа с enabled: false (notes/groups.js) никуда не ведет: в ней пока одни черновики. -->
  <div class="wallui" id="wallui">
    <span class="kicker">01 / заметки</span>
    <h2>Что почитать?</h2>
    <nav class="groups" aria-label="Группы заметок">
      {%- for g in noteGroups %}
      {%- if g.enabled %}
      {%- set n = collections.all | groupNotes(g.id) | length %}
      <a class="group" href="{{ pathPrefix }}/notes/{{ g.id }}/" data-g="{{ g.id }}">
        <span class="group__t">{{ g.title }}</span>
        <span class="group__d">{{ g.desc }}</span>
        <span class="group__m"><b>{{ n }}</b> {{ n | plural('заметка', 'заметки', 'заметок') }} <i>→</i></span>
      </a>
      {%- else %}
      {%- set n = collections.all | groupDrafts(g.id) | length %}
      <a class="group group--draft" href="#notes" data-g="{{ g.id }}" aria-disabled="true">
        <span class="group__t">{{ g.title }}</span>
        <span class="group__d">{{ g.desc }}</span>
        <span class="group__m">{{ g.embers | lower }} · <b>{{ n }}</b> {{ n | plural('черновик', 'черновика', 'черновиков') }}</span>
      </a>
      {%- endif %}
      {%- endfor %}
    </nav>
    <button class="back" id="back" type="button"><i>←</i> в комнату</button>
  </div>

  <!-- Подсказка по клавишам: свой набор в комнате и у стены. На тач-экранах скрыта. -->
  <div class="keys" aria-hidden="true">
    <span class="keys__set keys__set--room">
      <kbd data-k="w">W</kbd><kbd data-k="s">S</kbd><span>выбрать</span>
      <kbd data-k="d">D</kbd><span>войти</span>
    </span>
    <span class="keys__set keys__set--wall">
      <kbd data-k="a">A</kbd><span>в комнату</span>
      <kbd data-k="w">W</kbd><kbd data-k="s">S</kbd><span>группа</span>
      <kbd data-k="d">D</kbd><span>открыть</span>
    </span>
  </div>

  <!-- Уход в Cinema (cine.js, cine.css): полосы 2.32:1 и окно между ними. В окне
       hero.jpg страницы Cinema, стоит ровно как на ней; браузер раскрывает его во весь
       экран (vt.css). Файл должен быть тем же, что у Cinema, пиксель в пиксель.
       Черное между полосами - для возврата из Cinema. -->
  <div class="cine" aria-hidden="true">
    <i class="cine__bar cine__bar--top"></i>
    <div class="cine__frame"><img src="{{ pathPrefix }}/images/cinema/index/hero.jpg" alt=""></div>
    <i class="cine__black"></i>
    <i class="cine__bar cine__bar--bot"></i>
  </div>

  <div class="frameline">
    <span>кальян дымит</span>
    <span>утро подождет</span>
  </div>
</header>

<!-- Дымовой переход для раздела без своего перехода. У раздела, который еще не готов
     (data-soon на карточке), под названием появляется строка «в работе». -->
<div class="fog" id="fog" aria-live="polite">
  <div class="fog__inner">
    <span class="kicker" id="fogKicker">переход</span>
    <strong id="fogTitle"></strong>
    <p class="fog__soon" id="fogSoon" hidden></p>
  </div>
</div>

{# TEMP: стенд шрифтов (?lab), удалить вместе с файлом. Выключен; чтобы включить,
   вынести include из комментария.
{% include "world/fontlab.njk" %} #}
