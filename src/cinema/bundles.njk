---
# Склейка CSS/JS мира Cinema. Исходники лежат в _src/ и сами не публикуются:
# из src/cinema/ как есть копируются только *.html (см. .eleventy.js).
# Каждая запись — один файл в /cinema/: общая рамка + код страницы; части — пути от src/. Все бандлы
# лежат на одном уровне, поэтому url() в любом исходнике — относительно /cinema/.
# Новая страница: пара записей здесь + ../<имя>.css / ../<имя>.js в её index.html.
# Лендинг еще и переход в комнату и обратно: return.* и общий с комнатой world/_src/vt.css.
pagination:
  data: bundles
  size: 1
  alias: entry
bundles:
  - out: landing.css
    parts: [cinema/_src/cinema.css, cinema/_src/landing.css, cinema/_src/return.css, world/_src/vt.css]
  - out: landing.js
    parts: [cinema/_src/cinema.js, cinema/_src/landing.js, cinema/_src/return.js]
  - out: bebop.css
    parts: [cinema/_src/cinema.css, cinema/_src/bebop.css]
  # Своего JS у страницы Бибопа пока нет: карусели закомментированы.
  # Бандл нужен ради cinema.js (флаг cinemaReady и появление .rise).
  - out: bebop.js
    parts: [cinema/_src/cinema.js]
permalink: "/cinema/{{ entry.out }}"
eleventyExcludeFromCollections: true
---
{{ entry.parts | bundle | safe }}
